<!-- About Section -->
<section id="about" class="about">
    <h2 class="numbered-heading">About Me</h2>
    <div class="about-content">
        <div class="about-text">
            <div id="about-bio">
                {% for paragraph in profile.bio|split('\n\n')|slice(0, 3) %}
                    <p>{{ paragraph }}</p>
                {% endfor %}
            </div>
            <p>Here are a few technologies I've been working with recently:</p>
            <div class="about-skills" id="about-skills">
                {% set randomSkills = skills|slice(0, 5) %}
                {% for skill in randomSkills %}
                    <span class="tech-badge-small">
                        {% if skill['techicon-url'] %}
                            <img src="{{ skill['techicon-url'] }}" alt="{{ skill.title }}">
                        {% elseif skill['fa-url'] %}
                            <i class="{{ skill['fa-url']|split('#')|last }}" style="color: {{ skill.colour }};"></i>
                        {% endif %}
                        {{ skill.title }}
                    </span>
                {% endfor %}
            </div>
        </div>
        <div class="about-pic">
            <div class="wrapper">
                <img src="https://github.com/balljul.png" alt="{{ profile.name }} - GitHub Profile Picture" />
            </div>
        </div>
    </div>
</section>
