<section id="achievements">
    <div class="section-header reveal">
        <span class="section-number">04</span>
        <h2 class="section-title">Achievements & Recognition</h2>
        <div class="section-line"></div>
    </div>
    <div class="achievements-grid">
        {% for contest in achievements.contests %}
            <div class="achievement-card reveal">
                <div class="achievement-icon"><i class="fas fa-trophy"></i></div>
                <h4>{{ contest.name }}</h4>
                <p class="meta">{{ contest.achievement | upper }} &middot; {{ contest.date | date('M Y') }}</p>
                <p>{{ contest.description }}</p>
                {% if contest.technologies %}
                    <div class="achievement-tech">
                        {% for tech in contest.technologies %}
                            <span>{{ tech }}</span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
        {% for cert in achievements.certifications %}
            <div class="achievement-card reveal">
                <div class="achievement-icon"><i class="fas fa-shield-alt"></i></div>
                <h4>{{ cert.name }}</h4>
                <p class="meta">CERTIFICATION &middot; {{ cert.date | date('M Y') }}</p>
                <p>{{ cert.description }}</p>
            </div>
        {% endfor %}
    </div>
</section>
