<!-- Contact Section -->
<section id="contact" class="contact">
    <h2 class="numbered-heading">Get In Touch</h2>
    <div class="contact-content">
        <div class="contact-text">
            <h3 class="contact-subtitle">Let's Connect</h3>
            <p>
                I'm currently a student at HTL Villach IT, passionate about building exceptional digital experiences. 
                Although I'm not currently looking for any new opportunities, my inbox is always open. 
                Whether you have a question or just want to say hi, I'll try my best to get back to you!
            </p>
            <div class="contact-actions">
                <button id="export-cv-btn" class="btn cv-export-btn">
                    <span>Download CV</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7,10 12,15 17,10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                </button>
            </div>
        </div>
        <div class="contact-info">
            <div class="contact-item">
                <h4>Email</h4>
                <a href="mailto:{{ profile.contact.email }}">{{ profile.contact.email }}</a>
            </div>
            <div class="contact-item">
                <h4>Location</h4>
                <span>{{ profile.location }}</span>
            </div>
            <div class="contact-item">
                <h4>Social</h4>
                <div class="contact-links">
                    <a href="{{ profile.contact.github }}" target="_blank">GitHub</a>
                    <a href="{{ profile.contact.linkedin }}" target="_blank">LinkedIn</a>
                </div>
            </div>
        </div>
    </div>
</section>